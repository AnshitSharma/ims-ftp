{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ram model",
    "$comment": "DERIVED from the 37 ram records in ims-data on 2026-09-16, not hand-authored.\nIt describes what the catalogue actually contains so that a NEW record cannot quietly\nomit a field every existing record has -- the failure that let cpu.memory_types read a\nkey no record had, silently disabling that rule on every CPU for months.\nRegenerate rather than hand-edit when the corpus legitimately changes shape.",
    "type": "object",
    "required": [
        "capacity_GB",
        "features",
        "form_factor",
        "frequency_MHz",
        "memory_type",
        "module_type",
        "speed_MTs",
        "timing",
        "uuid",
        "voltage_V"
    ],
    "properties": {
        "capacity_GB": {
            "type": "integer"
        },
        "ecc_support": {
            "type": "boolean",
            "$comment": "present on 1 of 37 records"
        },
        "features": {
            "type": "object"
        },
        "form_factor": {
            "type": "string"
        },
        "frequency_MHz": {
            "type": "integer"
        },
        "kit_capacity_GB": {
            "type": "integer",
            "$comment": "present on 2 of 37 records"
        },
        "kit_configuration": {
            "type": "string",
            "$comment": "present on 2 of 37 records"
        },
        "label": {
            "type": "string",
            "$comment": "present on 29 of 37 records"
        },
        "memory_type": {
            "type": "string"
        },
        "module_type": {
            "type": "string"
        },
        "part_number": {
            "type": "string",
            "$comment": "present on 15 of 37 records"
        },
        "speed_MTs": {
            "type": "integer"
        },
        "timing": {
            "type": "object"
        },
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "$comment": "The only identity a model has and the sole join key to raminventory."
        },
        "voltage_V": {
            "type": "number"
        }
    },
    "additionalProperties": false
}
